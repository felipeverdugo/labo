<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="5dp"
    tools:context=".viewmodels.GameActivity">


    <TextView
        android:id="@+id/txtTituloJuego"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:paddingBottom="16dp"
        android:text="Limpia la cabeza del caballo"
        android:textSize="22sp"
        android:textStyle="bold" />


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp">


        <ImageView
            android:id="@+id/imgCaballo"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:contentDescription="Imagen del caballo"
        />



        <ImageView
            android:id="@+id/mancha1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Punto de limpieza 1"
            android:src="@drawable/mancha"
            android:translationX="-40dp"
            android:translationY="50dp" />

        <ImageView
            android:id="@+id/mancha2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Punto de limpieza 2"
            android:src="@drawable/mancha2"
            android:translationX="-75dp"
            android:translationY="0dp" />

        <ImageView
            android:id="@+id/mancha3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Punto de limpieza 3"
            android:src="@drawable/mancha3"
            android:translationX="25dp"
            android:translationY="25dp" />



        <ImageView
            android:id="@+id/mancha4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Punto de limpieza 4"
            android:src="@drawable/mancha3"
            android:translationX="-105dp"
            android:translationY="25dp" />



        <ImageView
            android:id="@+id/imgSilueta"
            android:layout_width="65dp"
            android:layout_height="177dp"
            android:layout_gravity="end|bottom"
            android:contentDescription="Silueta de la persona"
            android:src="@drawable/silueta_right"
            android:visibility="gone"/>


    </FrameLayout>

    <!-- Zonas de drop -->



    <!-- Todas las herramientas (se ocultan por defecto) -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Arrastra  una herramienta "
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/herramienta1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Herramienta 1"
            android:tag="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/herramienta2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Herramienta 2"
            android:tag="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/herramienta3"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Herramienta 3"
            android:tag="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/herramienta4"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Herramienta 4"
            android:tag="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/herramienta5"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Herramienta 5"
            android:tag="vertical"
            android:visibility="gone"
            tools:visibility="visible" />


    </LinearLayout>

</LinearLayout>
